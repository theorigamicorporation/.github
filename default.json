{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Org-wide Renovate preset: one batched non-major PR per repo, opened off-hours, with security fixes left immediate.",
  "timezone": "Europe/Sofia",
  "schedule": ["* 0-6 * * 1-5"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 * * 1"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": null,
    "schedule": ["at any time"],
    "prCreation": "immediate",
    "minimumReleaseAge": null,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Batch every non-major update into one PR per repo. Majors keep their own PRs.",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    }
  ]
}
